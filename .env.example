# ========================
# BribeShield AI - Environment Configuration
# ========================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DATABASE_URL=postgresql://bribeshield:bribeshield_secure_pass@localhost:5432/bribeshield_db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@bribeshield.org

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,video/mp4,audio/mpeg

# Data Retention (days)
COMPLAINT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# External API
EXTERNAL_API_KEY=your-external-api-key-for-grievance-integration

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

