{
  "name": "bribeshield-server",
  "version": "2.0.0",
  "description": "BribeShield AI Enterprise Backend with PostgreSQL/SQLite, Encryption, NLP, Audit Chains, and RBAC",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "use:sqlite": "node -e \"import('fs').then(fs => fs.copyFileSync('prisma/schema.sqlite.prisma', 'prisma/schema.prisma'))\" && npx prisma generate && npx prisma db push && node prisma/seed.js",
    "use:postgres": "node -e \"import('fs').then(fs => fs.copyFileSync('prisma/schema.postgres.prisma', 'prisma/schema.prisma'))\" && npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
